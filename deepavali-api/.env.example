PORT=10000
# Production: Render Postgres DATABASE_URL; never commit credentials
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set a long random password via Render environment; never store it in GitHub
ADMIN_PASSWORD=<set-in-render-dashboard>
# HMAC signing key for 8-hour administrator sessions. Generate 32+ random bytes.
ADMIN_SESSION_SECRET=<set-in-render-dashboard>
FRONTEND_ORIGIN=https://deepavali-dhamaka-spin-2026.onrender.com
NODE_ENV=production
